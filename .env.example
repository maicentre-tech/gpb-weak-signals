# --- Окружение -------------------------------------------------------------
ETI_ENVIRONMENT=local
ETI_DEBUG=true

# --- База данных -----------------------------------------------------------
ETI_DATABASE_URL=postgresql+psycopg://eti:eti@localhost:5432/eti

# --- Идентификация в polite pool внешних API -------------------------------
# OpenAlex и Crossref просят указывать контакт вызывающего. Подставьте
# рабочий почтовый адрес команды, не личный.
ETI_CONTACT_EMAIL=eti@example.org

# --- Учётные данные источников ---------------------------------------------
# GitHub: personal access token без скоупов достаточно для публичных данных
# (поднимает лимит с 60 до 5000 запросов/час).
ETI_GITHUB_TOKEN=
ETI_SEMANTIC_SCHOLAR_KEY=
# CORDIS: API-ключ. Без него доступны bulk-датасеты.
ETI_CORDIS_API_KEY=
# EPO OPS: BLOCKED до регистрации юрлица (§30).
ETI_EPO_OPS_KEY=
ETI_EPO_OPS_SECRET=

# --- LLM gateway -----------------------------------------------------------
# Локальная модель через OpenAI-совместимый endpoint (Ollama/vLLM).
# Публичные LLM API не использовать без согласования ИБ (§12).
ETI_LLM_BASE_URL=http://localhost:11434/v1
ETI_LLM_MODEL=qwen2.5:14b-instruct
ETI_LLM_API_KEY=

# --- Хранилище -------------------------------------------------------------
ETI_RAW_STORAGE_PATH=./data/raw
