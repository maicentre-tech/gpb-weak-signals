# Local Compose settings. Copy to .env; set ETI_POSTGRES_PASSWORD before startup.
ETI_ENVIRONMENT=local
ETI_DEBUG=false
ETI_POSTGRES_PASSWORD=
ETI_API_PORT=8000
ETI_UI_PORT=3000

# Used by non-Compose local development; Compose sets the internal db service URL.
ETI_DATABASE_URL=postgresql+psycopg://eti:replace-with-local-password@localhost:5432/eti

# Replace with a real team contact before making requests to polite-pool APIs.
ETI_CONTACT_EMAIL=team@example.org

# Optional provider credentials. Leave blank unless explicitly needed and approved.
ETI_GITHUB_TOKEN=
ETI_SEMANTIC_SCHOLAR_KEY=
ETI_CORDIS_API_KEY=
ETI_EPO_OPS_KEY=
ETI_EPO_OPS_SECRET=

# Optional host Ollama/OpenAI-compatible endpoint; no LLM service is started by Compose.
ETI_LLM_BASE_URL=http://host.docker.internal:11434/v1
ETI_LLM_MODEL=qwen2.5:14b-instruct
ETI_LLM_API_KEY=

ETI_RAW_STORAGE_PATH=./data/raw